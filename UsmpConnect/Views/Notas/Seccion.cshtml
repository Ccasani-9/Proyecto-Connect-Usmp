@model UsmpConnect.ViewModels.NotasSeccionViewModel
@{
    ViewData["Title"] = $"Notas · {Model.Curso}";
}

<div class="card-u page-head">
    <div>
        <a href="/" class="small"><i class="bi bi-arrow-left"></i> Volver a Inicio</a>
        <h1 class="mt-1">@Model.Curso</h1>
        <p>@Model.CodigoCurso · Sección @Model.Seccion · @Model.Alumnos.Count alumnos</p>
    </div>
    <button class="btn-guinda" type="submit" form="formNotas"><i class="bi bi-save me-1"></i>Guardar notas</button>
</div>

<form id="formNotas" method="post" class="card-u p">
    <p class="small text-muted"><i class="bi bi-info-circle me-1"></i>Al guardar, cada alumno con cambios recibe una notificación en <b>Noticias</b>.</p>
    <div class="table-responsive">
        <table class="table-u">
            <thead>
                <tr><th>Código</th><th>Alumno</th><th class="text-center">EP</th><th class="text-center">EF</th><th class="text-center">Promedio</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Alumnos.Count; i++)
                {
                    var a = Model.Alumnos[i];
                    <tr data-fila>
                        <td class="text-muted">@a.Codigo</td>
                        <td class="fw-semibold">
                            <input type="hidden" name="alumnos[@i].MatriculaId" value="@a.MatriculaId" />
                            @a.Nombre
                        </td>
                        <td class="text-center"><input class="form-control nota-input mx-auto" type="number" min="0" max="20" step="0.5" name="alumnos[@i].EP" value="@a.EP?.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td class="text-center"><input class="form-control nota-input mx-auto" type="number" min="0" max="20" step="0.5" name="alumnos[@i].EF" value="@a.EF?.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td class="text-center"><span class="tag tag-muted" data-prom>—</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Alumnos.Count == 0)
    {
        <div class="vacio"><i class="bi bi-people"></i>No hay alumnos matriculados en esta sección.</div>
    }
</form>

@section Scripts {
    <script>
        const pintar = fila => {
            const [ep, ef] = [...fila.querySelectorAll('input[type=number]')].map(i => i.value === '' ? null : Number(i.value));
            const tag = fila.querySelector('[data-prom]');
            if (ep === null || ef === null) { tag.textContent = '—'; tag.className = 'tag tag-muted'; return; }
            const p = (ep + ef) / 2;
            tag.textContent = p.toFixed(1);
            tag.className = 'tag ' + (p >= 13 ? 'tag-ok' : p >= 10.5 ? 'tag-warn' : 'tag-bad');
        };
        document.querySelectorAll('[data-fila]').forEach(f => { pintar(f); f.addEventListener('input', () => pintar(f)); });
    </script>
}
