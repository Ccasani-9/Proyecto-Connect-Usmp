@using UsmpConnect.Services
@model UsmpConnect.ViewModels.CalendarioViewModel
@{
    ViewData["Title"] = "Mi Calendario Académico";
    var fechaHoyIso = Model.FechaHoy.ToString("yyyy-MM-dd");
}

@section Styles {
    <style>
        .cal-container {
            background: #fff;
            border-radius: 14px;
            border: 1px solid var(--border);
            overflow: hidden;
        }
        .cal-header-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            background: #fafafa;
            flex-wrap: wrap;
            gap: 12px;
        }
        .cal-nav {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .cal-grid-header {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            text-align: center;
            font-weight: 600;
            font-size: .85rem;
            color: var(--muted);
            padding: 10px 0;
            border-bottom: 1px solid var(--border);
            background: #fff;
            width: 100%;
        }
        .cal-grid {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            background: var(--border);
            gap: 1px;
            width: 100%;
        }
        .cal-cell {
            background: #fff;
            min-height: 115px;
            padding: 8px 6px;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            transition: background .15s ease, box-shadow .15s ease;
            position: relative;
            min-width: 0;
            overflow: hidden;
            box-sizing: border-box;
        }
        .cal-cell:hover {
            background: #fdf5f5;
        }
        .cal-cell.selected {
            background: #fbf0f0;
            box-shadow: inset 0 0 0 2px var(--guinda);
        }
        .cal-cell.other-month {
            background: #fbfbfb;
            color: #b0b4bc;
            opacity: .6;
        }
        .cal-cell-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }
        .cal-day-num {
            font-size: .85rem;
            font-weight: 600;
            width: 24px;
            height: 24px;
            display: inline-grid;
            place-items: center;
            border-radius: 50%;
        }
        .cal-cell.is-today .cal-day-num {
            background: var(--guinda);
            color: #fff;
        }
        .cal-pills {
            display: flex;
            flex-direction: column;
            gap: 3px;
            overflow: hidden;
            min-width: 0;
            width: 100%;
        }
        .cal-pill {
            font-size: .72rem;
            line-height: 1.25;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 4px;
            min-width: 0;
            max-width: 100%;
            overflow: hidden;
        }
        .cal-pill span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
            flex: 1 1 auto;
        }
        .cal-pill i {
            flex-shrink: 0;
        }
        .cal-pill-clase {
            background: #f3e8ee;
            color: #7a152d;
            border-left: 2px solid var(--guinda);
        }
        .cal-pill-feriado {
            background: #fee2e2;
            color: #991b1b;
            border-left: 2px solid #ef4444;
            font-weight: 600;
        }
        .cal-pill-examen {
            background: #fef3c7;
            color: #92400e;
            border-left: 2px solid #f59e0b;
        }
        .cal-pill-entrega {
            background: #ede9fe;
            color: #5b21b6;
            border-left: 2px solid #8b5cf6;
        }
        .cal-pill-personal {
            background: #ecfdf5;
            color: #065f46;
            border-left: 2px solid #10b981;
        }
        .cal-pill-general {
            background: #eff6ff;
            color: #1e40af;
            border-left: 2px solid #3b82f6;
        }
        .cal-more {
            font-size: .7rem;
            color: var(--muted);
            font-weight: 600;
            margin-top: 2px;
        }
        .cal-detail-card {
            background: #fff;
            border-radius: 14px;
            border: 1px solid var(--border);
            padding: 20px;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .cal-detail-head {
            border-bottom: 1px solid var(--border);
            padding-bottom: 12px;
            margin-bottom: 16px;
        }
        .btn-toggle-horario {
            transition: all .2s ease;
        }
    </style>
}

<div class="card-u page-head">
    <div>
        <h1>Mi Calendario Académico</h1>
        <p>Visualiza tus cursos semanales, exámenes, fechas clave y feriados nacionales de Ley</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <!-- Botón Toggle de Horario Semanal: Activo por defecto -->
        <button class="btn btn-guinda btn-toggle-horario" type="button" id="btnToggleHorario" data-activo="true" title="Alternar visualización de cursos semanales">
            <i class="bi bi-clock-history me-1"></i>
            <span>Horario de clases: <b id="txtToggleHorario">Visible</b></span>
        </button>
        <button class="btn-guinda" type="button" data-bs-toggle="modal" data-bs-target="#modalEvento">
            <i class="bi bi-plus-lg me-1"></i>+ Nueva Actividad
        </button>
    </div>
</div>

<div class="row g-3">
    <!-- Cuadrícula interactiva de mes -->
    <div class="col-xl-8 col-lg-7">
        <div class="cal-container">
            <div class="cal-header-bar">
                <div class="cal-nav">
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="btnPrevMes" aria-label="Mes anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <h4 class="mb-0 fw-bold" id="calTituloMes" style="min-width: 170px; text-align: center;"></h4>
                    <button class="btn btn-sm btn-outline-secondary" type="button" id="btnNextMes" aria-label="Mes siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="btn btn-sm btn-light border ms-2" type="button" id="btnIrHoy">Hoy</button>
                </div>
                <div class="d-flex align-items-center gap-3 small text-muted flex-wrap">
                    <span class="d-flex align-items-center gap-1" id="leyendaClases"><span style="width:10px;height:10px;background:var(--guinda);border-radius:2px;display:inline-block"></span> Clases</span>
                    <span class="d-flex align-items-center gap-1"><span style="width:10px;height:10px;background:#ef4444;border-radius:2px;display:inline-block"></span> Feriados Perú</span>
                    <span class="d-flex align-items-center gap-1"><span style="width:10px;height:10px;background:#f59e0b;border-radius:2px;display:inline-block"></span> Exámenes</span>
                    <span class="d-flex align-items-center gap-1"><span style="width:10px;height:10px;background:#10b981;border-radius:2px;display:inline-block"></span> Personal</span>
                </div>
            </div>

            <div class="cal-grid-header">
                <div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div><div>Dom</div>
            </div>

            <div class="cal-grid" id="calGrid"></div>
        </div>
    </div>

    <!-- Panel de detalle del día seleccionado -->
    <div class="col-xl-4 col-lg-5">
        <div class="cal-detail-card">
            <div class="cal-detail-head">
                <span class="text-uppercase small text-muted fw-bold">Detalle del día</span>
                <h3 class="fw-bold mb-1 mt-1" id="diaSeleccionadoTitulo">Cargando...</h3>
                <span class="badge bg-danger-subtle text-danger" id="badgeHoy" style="display:none">Hoy</span>
            </div>

            <div class="flex-grow-1 overflow-auto" id="listaDetallesDia">
                <!-- Se rellena dinámicamente -->
            </div>

            <div class="pt-3 border-top mt-3">
                <button class="btn btn-outline-guinda w-100" type="button" id="btnAgregarParaEsteDia">
                    <i class="bi bi-plus-circle me-1"></i>+ Agregar actividad para este día
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nueva Actividad / Recordatorio -->
<div class="modal fade" id="modalEvento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-controller="Eventos" asp-action="Crear" method="post">
            <input type="hidden" name="returnUrl" value="/Calendario" />
            <div class="modal-header">
                <h5 class="modal-title">Nueva actividad / recordatorio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label" for="evTitulo">Título de la actividad</label>
                    <input class="form-control" id="evTitulo" name="titulo" maxlength="120" required placeholder="Ej. Entrega Parcial de Proyecto, Práctica Calificada..." />
                </div>
                <div class="mb-4">
                    <label class="form-label" for="evFecha">Fecha programada</label>
                    <input class="form-control" id="evFecha" name="fecha" type="date" required value="@fechaHoyIso" />
                </div>
                <button class="btn-guinda w-100" type="submit">Guardar en mi calendario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const hoyIso = '@fechaHoyIso';
            const clases = @Json.Serialize(Model.Clases);
            const eventos = @Json.Serialize(Model.Eventos);

            const mesesNombres = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Setiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            const diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

            let [anioActual, mesActual] = hoyIso.split('-').map(Number);
            mesActual--; // 0-indexed

            let diaSeleccionadoIso = hoyIso;

            // Por defecto SIEMPRE activado según indicación del usuario
            let mostrarHorario = true;
            const guardado = localStorage.getItem('usmp_ver_horario');
            if (guardado !== null) {
                mostrarHorario = guardado === 'true';
            }

            const gridEl = document.getElementById('calGrid');
            const tituloMesEl = document.getElementById('calTituloMes');
            const diaTituloEl = document.getElementById('diaSeleccionadoTitulo');
            const badgeHoyEl = document.getElementById('badgeHoy');
            const listaDetallesEl = document.getElementById('listaDetallesDia');
            const btnAgregarDia = document.getElementById('btnAgregarParaEsteDia');
            const inputFechaModal = document.getElementById('evFecha');
            const btnToggleHorario = document.getElementById('btnToggleHorario');
            const txtToggleHorario = document.getElementById('txtToggleHorario');
            const leyendaClases = document.getElementById('leyendaClases');

            function pad(n) { return String(n).padStart(2, '0'); }
            function toIso(y, m, d) { return `${y}-${pad(m + 1)}-${pad(d)}`; }

            function actualizarBotonToggle() {
                if (mostrarHorario) {
                    btnToggleHorario.className = 'btn btn-guinda btn-toggle-horario';
                    btnToggleHorario.innerHTML = '<i class="bi bi-clock-history me-1"></i> <span>Horario de clases: <b>Activado</b></span>';
                    leyendaClases.style.opacity = '1';
                } else {
                    btnToggleHorario.className = 'btn btn-outline-secondary btn-toggle-horario';
                    btnToggleHorario.innerHTML = '<i class="bi bi-eye-slash me-1"></i> <span>Horario de clases: <b>Oculto</b></span>';
                    leyendaClases.style.opacity = '0.35';
                }
            }

            btnToggleHorario.addEventListener('click', () => {
                mostrarHorario = !mostrarHorario;
                localStorage.setItem('usmp_ver_horario', String(mostrarHorario));
                actualizarBotonToggle();
                renderizarCalendario();
            });

            function renderizarCalendario() {
                tituloMesEl.textContent = `${mesesNombres[mesActual]} ${anioActual}`;
                gridEl.innerHTML = '';

                // Primer día del mes
                const primerDia = new Date(anioActual, mesActual, 1);
                // lunes=0, domingo=6
                const startDay = (primerDia.getDay() + 6) % 7;
                const diasEnMes = new Date(anioActual, mesActual + 1, 0).getDate();
                const diasEnMesPrev = new Date(anioActual, mesActual, 0).getDate();

                // Días previos del mes anterior
                for (let i = startDay - 1; i >= 0; i--) {
                    const diaNum = diasEnMesPrev - i;
                    const fechaPrev = new Date(anioActual, mesActual - 1, diaNum);
                    const iso = toIso(fechaPrev.getFullYear(), fechaPrev.getMonth(), diaNum);
                    gridEl.appendChild(crearCelda(diaNum, iso, true, fechaPrev.getDay()));
                }

                // Días del mes actual
                for (let d = 1; d <= diasEnMes; d++) {
                    const dateObj = new Date(anioActual, mesActual, d);
                    const iso = toIso(anioActual, mesActual, d);
                    gridEl.appendChild(crearCelda(d, iso, false, dateObj.getDay()));
                }

                // Días del siguiente mes para completar la cuadrícula (múltiplo de 7)
                const celdasUsadas = startDay + diasEnMes;
                const resto = (7 - (celdasUsadas % 7)) % 7;
                for (let nextD = 1; nextD <= resto; nextD++) {
                    const dateNext = new Date(anioActual, mesActual + 1, nextD);
                    const iso = toIso(dateNext.getFullYear(), dateNext.getMonth(), nextD);
                    gridEl.appendChild(crearCelda(nextD, iso, true, dateNext.getDay()));
                }

                actualizarPanelDetalle();
            }

            function crearCelda(num, iso, otroMes, jsDow) {
                const cell = document.createElement('div');
                cell.className = 'cal-cell' + (otroMes ? ' other-month' : '') + (iso === hoyIso ? ' is-today' : '') + (iso === diaSeleccionadoIso ? ' selected' : '');
                cell.dataset.iso = iso;

                const header = document.createElement('div');
                header.className = 'cal-cell-header';
                header.innerHTML = `<span class="cal-day-num">${num}</span>`;
                cell.appendChild(header);

                const pillsContainer = document.createElement('div');
                pillsContainer.className = 'cal-pills';

                // Clases del día (se repiten semanalmente por día de la semana)
                const clasesDelDia = mostrarHorario ? clases.filter(c => c.dia === jsDow) : [];
                // Eventos de la fecha específica (feriados, exámenes, entregas, notas personales)
                const eventosDelDia = eventos.filter(e => e.fecha === iso);

                let mostrados = 0;
                const maxMostrar = 3;

                // 1. Mostrar feriados nacionales primero (máxima prioridad)
                for (const ev of eventosDelDia.filter(e => e.tipo === 'Feriado' || e.titulo.toLowerCase().includes('feriado'))) {
                    if (mostrados >= maxMostrar) break;
                    const pill = document.createElement('div');
                    pill.className = 'cal-pill cal-pill-feriado';
                    pill.title = ev.titulo;
                    pill.innerHTML = `<i class="bi bi-flag-fill"></i> <span>${ev.titulo.replace('🇵🇪 Feriado: ', '')}</span>`;
                    pillsContainer.appendChild(pill);
                    mostrados++;
                }

                // 2. Mostrar exámenes y entregas
                for (const ev of eventosDelDia.filter(e => e.tipo !== 'Feriado' && !e.titulo.toLowerCase().includes('feriado'))) {
                    if (mostrados >= maxMostrar) break;
                    const pill = document.createElement('div');
                    const claseTipo = ev.personal ? 'cal-pill-personal' : (ev.tipo === 'Evaluacion' ? 'cal-pill-examen' : (ev.tipo === 'Entrega' ? 'cal-pill-entrega' : 'cal-pill-general'));
                    pill.className = 'cal-pill ' + claseTipo;
                    pill.title = ev.titulo;
                    pill.innerHTML = `<i class="bi ${ev.personal ? 'bi-pin-fill' : (ev.tipo === 'Evaluacion' ? 'bi-exclamation-triangle' : 'bi-calendar-check')}"></i> <span>${ev.titulo}</span>`;
                    pillsContainer.appendChild(pill);
                    mostrados++;
                }

                // 3. Mostrar clases semanales si el horario está activo
                if (mostrarHorario) {
                    for (const cl of clasesDelDia) {
                        if (mostrados >= maxMostrar) break;
                        const pill = document.createElement('div');
                        pill.className = 'cal-pill cal-pill-clase';
                        const hora = cl.inicio ? cl.inicio.substring(0, 5) : '';
                        pill.title = `${hora} - ${cl.curso} (${cl.aula})`;
                        pill.innerHTML = `<i class="bi bi-clock"></i> <span>${hora} ${cl.curso}</span>`;
                        pillsContainer.appendChild(pill);
                        mostrados++;
                    }
                }

                const totalItems = clasesDelDia.length + eventosDelDia.length;
                if (totalItems > maxMostrar) {
                    const more = document.createElement('div');
                    more.className = 'cal-more';
                    more.textContent = `+${totalItems - maxMostrar} más`;
                    pillsContainer.appendChild(more);
                }

                cell.appendChild(pillsContainer);

                cell.addEventListener('click', () => {
                    document.querySelectorAll('.cal-cell.selected').forEach(c => c.classList.remove('selected'));
                    cell.classList.add('selected');
                    diaSeleccionadoIso = iso;
                    actualizarPanelDetalle();
                });

                return cell;
            }

            function actualizarPanelDetalle() {
                const partes = diaSeleccionadoIso.split('-').map(Number);
                const d = new Date(partes[0], partes[1] - 1, partes[2]);
                const nombreDia = diasSemana[d.getDay()];
                diaTituloEl.textContent = `${nombreDia}, ${partes[2]} de ${mesesNombres[partes[1] - 1]}`;
                badgeHoyEl.style.display = diaSeleccionadoIso === hoyIso ? 'inline-block' : 'none';

                listaDetallesEl.innerHTML = '';

                const jsDow = d.getDay();
                const clasesDelDia = clases.filter(c => c.dia === jsDow);
                const eventosDelDia = eventos.filter(e => e.fecha === diaSeleccionadoIso);
                const feriadosDelDia = eventosDelDia.filter(e => e.tipo === 'Feriado' || e.titulo.toLowerCase().includes('feriado'));
                const otrosEventos = eventosDelDia.filter(e => !feriadosDelDia.includes(e));

                // 1. Mostrar banner patriótico de feriado oficial si aplica
                if (feriadosDelDia.length > 0) {
                    feriadosDelDia.forEach(f => {
                        const divFeriado = document.createElement('div');
                        divFeriado.className = 'alert alert-danger border-0 p-2 mb-3 d-flex align-items-center gap-2 small';
                        divFeriado.style.borderRadius = '10px';
                        divFeriado.innerHTML = `
                            <i class="bi bi-flag-fill text-danger fs-5 ms-1"></i>
                            <div>
                                <strong class="text-danger">${f.titulo}</strong>
                                <div class="text-muted" style="font-size:.78rem">Feriado nacional oficial remunerado (Sector Privado y Público — D. Leg. 713).</div>
                            </div>
                        `;
                        listaDetallesEl.appendChild(divFeriado);
                    });
                }

                // 2. Si no hay nada que mostrar en este día
                const hayClasesParaMostrar = mostrarHorario && clasesDelDia.length > 0;
                if (!hayClasesParaMostrar && otrosEventos.length === 0 && feriadosDelDia.length === 0) {
                    listaDetallesEl.innerHTML += `
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-cup-hot fs-2 d-block mb-2 text-secondary"></i>
                            <div class="fw-semibold">Sin actividades para este día</div>
                            <small>${mostrarHorario ? 'No tienes clases ni recordatorios agendados.' : 'El horario de clases está oculto.'}</small>
                        </div>
                    `;
                    return;
                }

                // 3. Sección de Actividades y Eventos
                if (otrosEventos.length > 0) {
                    const secEventos = document.createElement('div');
                    secEventos.className = 'mb-3';
                    secEventos.innerHTML = `<div class="fw-bold small text-muted text-uppercase mb-2"><i class="bi bi-calendar-check me-1"></i>Actividades y recordatorios (${otrosEventos.length})</div>`;

                    otrosEventos.forEach(ev => {
                        const item = document.createElement('div');
                        item.className = 'p-2 rounded mb-2 border d-flex justify-content-between align-items-center';
                        item.style.background = ev.personal ? '#f0fdf4' : (ev.tipo === 'Evaluacion' ? '#fffbeb' : '#eff6ff');

                        let deleteHtml = '';
                        if (ev.personal) {
                            deleteHtml = `
                                <form action="/Eventos/Eliminar" method="post" class="m-0" onsubmit="return confirm('¿Eliminar este recordatorio?')">
                                    <input type="hidden" name="id" value="${ev.id}" />
                                    <input type="hidden" name="returnUrl" value="/Calendario" />
                                    <button class="btn btn-sm btn-link text-danger p-0 ms-2" type="submit" title="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            `;
                        }

                        item.innerHTML = `
                            <div>
                                <div class="fw-semibold ${ev.personal ? 'text-success' : 'text-primary'}">${ev.titulo}</div>
                                <small class="text-muted">${ev.personal ? 'Recordatorio Personal' : ev.tipo}</small>
                            </div>
                            ${deleteHtml}
                        `;
                        secEventos.appendChild(item);
                    });
                    listaDetallesEl.appendChild(secEventos);
                }

                // 4. Sección de Clases universitarias
                if (clasesDelDia.length > 0) {
                    const secClases = document.createElement('div');
                    secClases.className = 'mb-3';
                    if (!mostrarHorario) {
                        secClases.style.opacity = '0.55';
                    }
                    secClases.innerHTML = `
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-muted text-uppercase"><i class="bi bi-book me-1"></i>Clases del día (${clasesDelDia.length})</span>
                            ${!mostrarHorario ? '<span class="badge bg-secondary-subtle text-secondary" style="font-size:.7rem">Oculto en calendario</span>' : ''}
                        </div>
                    `;
                    
                    clasesDelDia.forEach(c => {
                        const item = document.createElement('div');
                        item.className = 'p-2 rounded mb-2 border';
                        item.style.background = '#fdfbfb';
                        item.innerHTML = `
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="fw-bold" style="color:var(--guinda)">${c.curso}</div>
                                <span class="badge bg-light text-dark border">${c.rango}</span>
                            </div>
                            <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1"></i>${c.aula} · ${c.detalle}</div>
                        `;
                        secClases.appendChild(item);
                    });
                    listaDetallesEl.appendChild(secClases);
                }
            }

            // Botones de navegación
            document.getElementById('btnPrevMes').addEventListener('click', () => {
                mesActual--;
                if (mesActual < 0) { mesActual = 11; anioActual--; }
                renderizarCalendario();
            });

            document.getElementById('btnNextMes').addEventListener('click', () => {
                mesActual++;
                if (mesActual > 11) { mesActual = 0; anioActual++; }
                renderizarCalendario();
            });

            document.getElementById('btnIrHoy').addEventListener('click', () => {
                const [y, m] = hoyIso.split('-').map(Number);
                anioActual = y;
                mesActual = m - 1;
                diaSeleccionadoIso = hoyIso;
                renderizarCalendario();
            });

            btnAgregarDia.addEventListener('click', () => {
                inputFechaModal.value = diaSeleccionadoIso;
                const modal = new bootstrap.Modal(document.getElementById('modalEvento'));
                modal.show();
            });

            actualizarBotonToggle();
            renderizarCalendario();
        })();
    </script>
}
