@model CatedraIndexViewModel
@{
    ViewData["Title"] = "Cátedra & Tips";
}

@section Styles {
    <partial name="_Estilos" />
}

<partial name="_Barra" model="Model.Barra" />

<div class="d-flex justify-content-between align-items-baseline mb-3">
    <h2 class="h5 fw-bold m-0">
        @(Model.Barra.Ciclo is null ? "Todos los cursos" : $"Cursos del {Curso.Romano(Model.Barra.Ciclo.Value)} Ciclo")
        <span class="text-muted fw-normal fs-6">(@Model.Cursos.Count)</span>
    </h2>
    <small class="text-muted">Elige un curso para ver a sus docentes y los tips de la comunidad</small>
</div>

@if (Model.Cursos.Count == 0)
{
    <div class="card-u vacio">
        <i class="bi bi-bookmark"></i>
        No encontramos cursos@(string.IsNullOrWhiteSpace(Model.Barra.Busqueda) ? "" : $" ni docentes para “{Model.Barra.Busqueda}”").
    </div>
}

<div class="row g-3">
    @foreach (var c in Model.Cursos)
    {
        <div class="col-xl-4 col-md-6">
            <a class="card-u p curso-card" href="/Catedra/Curso/@c.Id">
                <div>
                    <div class="fw-bold fs-6">@c.Nombre</div>
                    <div class="curso-meta">Código: @c.Codigo │ Créditos: @c.Creditos │ @Curso.Romano(c.Ciclo) Ciclo</div>
                </div>
                <div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Dificultad comunitaria</span>
                        <b style="color: var(--guinda)">@(c.Dificultad is null ? "—" : $"{c.Dificultad:0.0} / 5.0")</b>
                    </div>
                    <div class="dif-barra"><span style="width: @((c.Dificultad ?? 0) / 5 * 100)%"></span></div>
                </div>
                <div class="d-flex justify-content-between align-items-end gap-2 mt-auto">
                    <div class="curso-meta"><i class="bi bi-person-video3 me-1"></i>@(c.Docentes.Count == 0 ? "Sin docentes este periodo" : string.Join(" · ", c.Docentes))</div>
                    <span class="tag tag-guinda text-nowrap">@c.NumTips @(c.NumTips == 1 ? "tip" : "tips")</span>
                </div>
            </a>
        </div>
    }
</div>

@if (Model.Barra.PuedeAportar)
{
    <partial name="_AportarTip" model="Model.Formulario" />
}
