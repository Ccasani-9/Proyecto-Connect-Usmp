@using UsmpConnect.Models
@using UsmpConnect.ViewModels
@model RegistroViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Crear cuenta";
}

<h2>Crear cuenta</h2>
<p class="text-muted mb-4">Únete a la comunidad de estudiantes USMP Connect.</p>

<form asp-action="Registro" method="post" novalidate id="formRegistro">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="row g-3">
        <div class="col-6">
            <label asp-for="Nombres" class="form-label"></label>
            <input asp-for="Nombres" class="form-control" placeholder="Alessandro" />
            <span asp-validation-for="Nombres"></span>
        </div>
        <div class="col-6">
            <label asp-for="Apellidos" class="form-label"></label>
            <input asp-for="Apellidos" class="form-control" placeholder="Morales Quispe" />
            <span asp-validation-for="Apellidos"></span>
        </div>

        <div class="col-12">
            <label asp-for="CodigoAlumno" class="form-label"></label>
            <input asp-for="CodigoAlumno" class="form-control" placeholder="Ej. 2021123456" inputmode="numeric" />
            <span asp-validation-for="CodigoAlumno"></span>
        </div>

        <div class="col-12">
            <label asp-for="Escuela" class="form-label">Escuela profesional</label>
            <select asp-for="Escuela" class="form-select" asp-items="@(new SelectList(RegistroViewModel.Escuelas))">
                <option value="">Seleccionar escuela</option>
            </select>
            <span asp-validation-for="Escuela"></span>
        </div>
        <div class="col-12">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" placeholder="nombre.apellido@usmp.pe" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="col-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="col-6">
            <label asp-for="ConfirmarPassword" class="form-label"></label>
            <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarPassword"></span>
        </div>
    </div>

    <button type="submit" class="btn-guinda w-100 py-2 mt-4">Crear cuenta</button>
</form>

<p class="text-center mt-4 mb-0">¿Ya tienes cuenta? <a asp-action="Login" class="fw-bold">Inicia sesión</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
