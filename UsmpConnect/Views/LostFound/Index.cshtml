@model LostFoundIndexViewModel
@{
    ViewData["Title"] = "Objetos Perdidos";
    var encontrados = Model.TabActiva == "encontrados";
    var extraviados = Model.TabActiva == "extraviados";
    var misPublicaciones = Model.TabActiva == "mis-publicaciones";
    var misSolicitudes = Model.TabActiva == "mis-solicitudes";
    var ahora = HoraPeru.Ahora.ToString("yyyy-MM-ddTHH:mm");
}

@section Styles {
    <style>
        .lf-tabs { display: flex; gap: 24px; border-bottom: 1px solid var(--border); margin-bottom: 14px; flex-wrap: wrap; }
        .lf-tabs a { padding: 0 2px 10px; color: var(--muted); font-weight: 600; border-bottom: 2px solid transparent; margin-bottom: -1px; text-decoration: none; }
        .lf-tabs a:hover { color: var(--text); }
        .lf-tabs a.active { color: var(--guinda); border-color: var(--guinda); }
        .lf-card { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
        .lf-foto { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 9; background: #f6f6f8; }
        .lf-foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
        .lf-foto .ph { font-size: 3rem; color: var(--muted-2); }
        .lf-foto .tag { position: absolute; top: 12px; left: 12px; }
        .lf-body { display: flex; flex-direction: column; flex: 1; padding: 14px 16px 16px; }
        .lf-meta { color: var(--muted); font-size: .82rem; display: flex; align-items: center; gap: 6px; margin-top: 3px; }
        .lf-custodia { border-top: 1px solid var(--border); margin: 10px 0 12px; padding-top: 10px; }
        .lf-devuelto { opacity: .7; }
        .reclamo-resumen { display: flex; gap: 12px; align-items: center; background: var(--guinda-50); border: 1px solid var(--guinda-100); border-radius: 12px; padding: 12px; }
        .reclamo-resumen .mini { width: 56px; height: 56px; border-radius: 8px; background: #e7e8ec; display: grid; place-items: center; overflow: hidden; flex-shrink: 0; color: var(--muted); }
        .reclamo-resumen .mini img { width: 100%; height: 100%; object-fit: cover; }
    </style>
}

<div class="card-u page-head">
    <div>
        <h1>Objetos Perdidos (Campus FIA)</h1>
        <p>Reporta pertenencias encontradas bajo custodia o solicita el reclamo seguro de tus objetos extraviados</p>
    </div>
    <button class="btn-guinda" type="button" data-bs-toggle="modal" data-bs-target="#modalReportar">
        <i class="bi bi-plus-lg me-1"></i>Reportar Objeto
    </button>
</div>

<div class="card-u p mb-3">
    <nav class="lf-tabs">
        <a href="/ObjetosPerdidos?tab=encontrados" class="@(encontrados ? "active" : "")">
            <i class="bi bi-box-seam me-1"></i>Objetos Encontrados (En Custodia)
        </a>
        <a href="/ObjetosPerdidos?tab=extraviados" class="@(extraviados ? "active" : "")">
            <i class="bi bi-search me-1"></i>Objetos Extraviados (Se Busca)
        </a>
        <a href="/ObjetosPerdidos?tab=mis-publicaciones" class="@(misPublicaciones ? "active" : "")">
            <i class="bi bi-person-lines-fill me-1"></i>Mis Publicaciones
            @if (Model.MisPublicaciones.Count > 0)
            {
                <span class="badge bg-guinda text-white ms-1">@Model.MisPublicaciones.Count</span>
            }
        </a>
        <a href="/ObjetosPerdidos?tab=mis-solicitudes" class="@(misSolicitudes ? "active" : "")">
            <i class="bi bi-hand-index-thumb me-1"></i>Mis Solicitudes Enviadas
            @if (Model.MisSolicitudes.Count > 0)
            {
                <span class="badge bg-guinda text-white ms-1">@Model.MisSolicitudes.Count</span>
            }
        </a>
    </nav>

    @if (encontrados || extraviados)
    {
        <div class="chips" data-filtro="categoria">
            <button type="button" class="chip active" data-valor="todo">Todo</button>
            @foreach (var c in Enum.GetValues<CategoriaObjeto>())
            {
                <button type="button" class="chip" data-valor="@c">@c.Nombre()</button>
            }
        </div>
    }
</div>

@* TAB 1 & 2: PUBLIC FEED (ENCONTRADOS Y EXTRAVIADOS) *@
@if (encontrados || extraviados)
{
    @if (Model.Objetos.Count == 0)
    {
        <div class="card-u vacio">
            <i class="bi bi-search"></i>
            @(encontrados ? "No hay objetos encontrados reportados por ahora." : "Nadie está buscando objetos por ahora.")
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var o in Model.Objetos)
            {
                var propio = o.ReportanteId == Model.UsuarioId;
                var devuelto = o.Estado == EstadoObjeto.Devuelto;
                var hoy = DateOnly.FromDateTime(HoraPeru.DesdeUtc(o.FechaReporte)) == HoraPeru.Hoy;
                var (tag, claseTag) = (devuelto, encontrados, hoy) switch
                {
                    (true, true, _) => ("Reclamado", "tag-info"),
                    (true, false, _) => ("Recuperado", "tag-info"),
                    (false, _, true) => ("Reportado hoy", "tag-warn"),
                    (false, true, false) => ("En custodia", "tag-ok"),
                    _ => ("Se busca", "tag-bad")
                };
                <div class="col-xl-4 col-md-6" data-categoria="@o.Categoria">
                    <div class="card-u lf-card @(devuelto ? "lf-devuelto" : "")">
                        <div class="lf-foto">
                            @if (o.FotoUrl is not null)
                            {
                                <img src="@o.FotoUrl" alt="@o.Titulo" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&fit=crop&w=600&q=80';" />
                            }
                            else
                            {
                                <i class="bi bi-@o.Categoria.Icono() ph"></i>
                            }
                            <span class="tag tag-upper @claseTag">@tag</span>
                        </div>
                        <div class="lf-body">
                            <div class="fw-bold">@o.Titulo</div>
                            <div class="lf-meta"><i class="bi bi-geo-alt"></i>@o.Ubicacion</div>
                            <div class="lf-meta"><i class="bi bi-calendar3"></i>@LostFoundUi.FechaCorta(o.FechaHallazgo)</div>
                            <div class="lf-custodia small text-muted">
                                @if (encontrados)
                                {
                                    @if (devuelto)
                                    {
                                        <div class="d-flex align-items-center gap-1 text-success fw-semibold mb-1">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>Entregado a su dueño oficial</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-1 text-dark fw-semibold mb-1" title="La garita u oficina específica se revela al titular tras aprobar su reclamo">
                                            <i class="bi bi-shield-lock-fill text-primary"></i>
                                            <span>Custodia FIA (Ubicación Confidencial)</span>
                                        </div>
                                        <div class="text-muted" style="font-size: .78rem;">
                                            <i class="bi bi-info-circle me-1"></i>Punto de retiro se revela tras validar tus señas particulares.
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <i class="bi bi-person me-1"></i>Reportado por @o.Reportante.NombreCorto
                                    </div>
                                    @if (o.Descripcion is not null)
                                    {
                                        <div class="mt-1">@o.Descripcion</div>
                                    }
                                }
                            </div>

                            <div class="mt-auto d-grid gap-2">
                                @if (propio)
                                {
                                    <div class="p-2 bg-light rounded text-center border small text-muted">
                                        <i class="bi bi-pin-angle me-1"></i>Tu publicación · <a href="/ObjetosPerdidos?tab=mis-publicaciones" class="fw-bold text-guinda">Adminístrala aquí</a>
                                    </div>
                                }
                                else if (devuelto)
                                {
                                    <button class="btn btn-outline-guinda py-2" type="button" disabled>@(encontrados ? "Entregado a su dueño" : "Ya fue recuperado")</button>
                                }
                                else if (!encontrados)
                                {
                                    <a class="btn btn-wa py-2" target="_blank" rel="noopener"
                                       href="@WhatsApp.Enlace(o.WhatsApp!, $"Hola {o.Reportante.Nombres}, creo que encontré tu objeto \"{o.Titulo}\" (vi tu reporte en USMP Connect).")">
                                        <i class="bi bi-whatsapp me-1"></i>Lo encontré / Contactar por WhatsApp
                                    </a>
                                }
                                else if (Model.MisReclamos.Contains(o.Id))
                                {
                                    <a class="btn btn-outline-guinda py-2" href="/ObjetosPerdidos?tab=mis-solicitudes">
                                        <i class="bi bi-hourglass-split me-1"></i>Solicitud enviada (Ver estado)
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-outline-guinda py-2" type="button" data-bs-toggle="modal" data-bs-target="#modalReclamar"
                                            data-id="@o.Id" data-titulo="@o.Titulo" data-lugar="@o.Ubicacion"
                                            data-fecha="@LostFoundUi.FechaCorta(o.FechaHallazgo)" data-foto="@o.FotoUrl">
                                        🙋 Reclamar pertenencia
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* TAB 3: MIS PUBLICACIONES (PRIVADO DEL USUARIO) *@
@if (misPublicaciones)
{
    @if (Model.MisPublicaciones.Count == 0)
    {
        <div class="card-u vacio">
            <i class="bi bi-journal-x"></i>
            No has publicado ningún objeto encontrado ni extraviado aún.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var o in Model.MisPublicaciones)
            {
                var devuelto = o.Estado == EstadoObjeto.Devuelto;
                var reclamosPendientes = o.Reclamos.Count(r => r.Estado == EstadoReclamo.Pendiente);
                var totalReclamos = o.Reclamos.Count;
                <div class="col-xl-4 col-md-6">
                    <div class="card-u lf-card @(devuelto ? "lf-devuelto" : "")">
                        <div class="lf-foto">
                            @if (o.FotoUrl is not null)
                            {
                                <img src="@o.FotoUrl" alt="@o.Titulo" loading="lazy" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&fit=crop&w=600&q=80';" />
                            }
                            else
                            {
                                <i class="bi bi-@o.Categoria.Icono() ph"></i>
                            }
                            <span class="tag tag-upper @(o.Tipo == TipoReporte.Encontrado ? "tag-ok" : "tag-warn")">
                                @(o.Tipo == TipoReporte.Encontrado ? "Encontrado" : "Extraviado")
                            </span>
                        </div>
                        <div class="lf-body">
                            <div class="fw-bold">@o.Titulo</div>
                            <div class="lf-meta"><i class="bi bi-geo-alt"></i>@o.Ubicacion</div>
                            <div class="lf-meta"><i class="bi bi-calendar3"></i>@LostFoundUi.FechaCorta(o.FechaHallazgo)</div>

                            <div class="lf-custodia small">
                                @if (o.Tipo == TipoReporte.Encontrado)
                                {
                                    <div class="text-dark fw-semibold mb-1">
                                        <i class="bi bi-shield-check text-primary me-1"></i>Punto de custodia: @(devuelto ? "Entregado" : o.Custodia?.Nombre() ?? "Seguridad FIA")
                                    </div>
                                    <div class="text-muted" style="font-size: .78rem;">
                                        (La ubicación exacta solo se le revela al alumno cuyo reclamo apruebes).
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted mb-1"><i class="bi bi-whatsapp me-1"></i>WhatsApp: @o.WhatsApp</div>
                                    @if (!string.IsNullOrEmpty(o.Descripcion))
                                    {
                                        <div class="text-muted">@o.Descripcion</div>
                                    }
                                }
                            </div>

                            <div class="mt-auto d-grid gap-2">
                                @if (o.Tipo == TipoReporte.Encontrado && !devuelto)
                                {
                                    <a class="btn @(reclamosPendientes > 0 ? "btn-guinda fw-bold" : "btn-outline-guinda") py-2 d-flex align-items-center justify-content-center gap-2"
                                       href="/ObjetosPerdidos/Reclamos/@o.Id">
                                        <i class="bi bi-inbox-fill"></i>Ver solicitudes recibidas
                                        @if (reclamosPendientes > 0)
                                        {
                                            <span class="badge badge-count-guinda">@reclamosPendientes pendiente(s)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">(@totalReclamos)</span>
                                        }
                                    </a>
                                }
                                @if (!devuelto)
                                {
                                    <form asp-action="MarcarDevuelto" asp-route-id="@o.Id" method="post" class="d-grid">
                                        <button class="btn btn-soft py-2" type="submit">
                                            <i class="bi bi-check2 me-1"></i>@(o.Tipo == TipoReporte.Encontrado ? "Marcar como entregado a su dueño" : "Marcar como ya recuperado")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline-guinda py-2" type="button" disabled>
                                        <i class="bi bi-check-circle me-1"></i>@(o.Tipo == TipoReporte.Encontrado ? "Entregado a su dueño" : "Recuperado")
                                    </button>
                                }
                                <form asp-action="Eliminar" asp-route-id="@o.Id" method="post" class="d-grid" onsubmit="return confirm('¿Eliminar permanentemente este reporte?')">
                                    <button class="btn btn-link btn-sm text-danger" type="submit">Eliminar publicación</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@* TAB 4: MIS SOLICITUDES ENVIADAS (RECLAMOS HECHOS POR EL USUARIO) *@
@if (misSolicitudes)
{
    @if (Model.MisSolicitudes.Count == 0)
    {
        <div class="card-u vacio">
            <i class="bi bi-inbox"></i>
            No has enviado ninguna solicitud para reclamar objetos aún.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.MisSolicitudes)
            {
                var o = r.Objeto;
                <div class="col-lg-6">
                    <div class="card-u p h-100 d-flex flex-column">
                        <div class="d-flex gap-3 align-items-start mb-3">
                            <div style="width: 72px; height: 72px; border-radius: 10px; overflow: hidden; background: #f4f4f5; flex-shrink: 0; display: grid; place-items: center;">
                                @if (o.FotoUrl is not null)
                                {
                                    <img src="@o.FotoUrl" alt="@o.Titulo" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1597872200969-2b65d56bd16b?auto=format&fit=crop&w=600&q=80';" />
                                }
                                else
                                {
                                    <i class="bi bi-@o.Categoria.Icono() fs-2 text-muted"></i>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-6">@o.Titulo</div>
                                <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>Hallado en: @o.Ubicacion</div>
                                <div class="small text-muted"><i class="bi bi-calendar3 me-1"></i>@LostFoundUi.FechaCorta(o.FechaHallazgo)</div>
                            </div>
                            <span class="tag tag-upper @(r.Estado switch { EstadoReclamo.Aprobado => "tag-ok", EstadoReclamo.Rechazado => "tag-bad", _ => "tag-warn" })">
                                @r.Estado.Nombre()
                            </span>
                        </div>

                        <div class="p-2 mb-3 bg-light rounded border small">
                            <span class="fw-semibold text-muted d-block mb-1">Tu descripción enviada:</span>
                            <span class="text-dark">“@r.Descripcion”</span>
                        </div>

                        <div class="mt-auto">
                            @if (r.Estado == EstadoReclamo.Pendiente)
                            {
                                <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                                    <i class="bi bi-hourglass-split fs-5"></i>
                                    <div><strong>En revisión:</strong> Quien encontró el objeto está revisando si tus características coinciden. Te notificaremos en cuanto lo apruebe.</div>
                                </div>
                            }
                            else if (r.Estado == EstadoReclamo.Aprobado)
                            {
                                <div class="alert alert-success py-3 px-3 mb-0">
                                    <div class="d-flex align-items-center gap-2 fw-bold text-success mb-2">
                                        <i class="bi bi-check-circle-fill fs-5"></i> ¡Solicitud Aprobada! Tu pertenencia está confirmada
                                    </div>
                                    <div class="p-2 bg-white rounded border mb-2">
                                        <div class="small text-muted fw-bold">📍 LUGAR EXACTO PARA RETIRAR:</div>
                                        <div class="fs-6 fw-bold text-primary">
                                            @(o.Custodia?.Nombre() ?? "Oficina de Seguridad Central FIA")
                                        </div>
                                    </div>
                                    <p class="small text-muted mb-3">
                                        Acércate a la garita u oficina indicada con tu <strong>carné universitario</strong> físico o virtual y solicita tu pertenencia indicando que fue registrada en USMP Connect.
                                    </p>
                                    @if (o.Estado != EstadoObjeto.Devuelto)
                                    {
                                        <form asp-action="ConfirmarRecepcion" asp-route-id="@r.Id" method="post">
                                            <button class="btn btn-success w-100 py-2 fw-bold" type="submit">
                                                <i class="bi bi-check2-all me-1"></i>✓ Ya lo recogí en Garita (Confirmar recepción)
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="text-center py-2 text-success fw-bold small">
                                            <i class="bi bi-bag-check me-1"></i>Recepción confirmada con éxito. ¡Pertenencia recuperada!
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-0">
                                    <i class="bi bi-x-circle-fill fs-5"></i>
                                    <div><strong>No coincide:</strong> Las características no coincidieron con el objeto hallado. Si consideras que es un error, acércate a Seguridad Central FIA con tu carné.</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<!-- Modal Reportar objeto encontrado / perdido -->
<div class="modal fade" id="modalReportar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reportar Pertenencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form asp-action="Reportar" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-bold" for="rep-tipo">¿Qué deseas reportar?</label>
                        <select class="form-select" id="rep-tipo" name="Tipo" required onchange="actualizarTipoReporte(this.value)">
                            <!option value="Encontrado" @(extraviados ? "" : "selected")>Encontré un objeto en el campus</!option>
                            <!option value="Perdido" @(extraviados ? "selected" : "")>Perdí una pertenencia (Se busca)</!option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rep-titulo">Título del objeto</label>
                        <input class="form-control" id="rep-titulo" name="Titulo" maxlength="100" required placeholder="Ej. Carné universitario, audífonos negros..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rep-categoria">Categoría</label>
                        <select class="form-select" id="rep-categoria" name="Categoria" required>
                            <option value="">Seleccionar categoría</option>
                            @foreach (var c in Enum.GetValues<CategoriaObjeto>())
                            {
                                <option value="@c">@c.Nombre()</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="rep-pabellon">Pabellón / Edificio</label>
                            <select class="form-select" id="rep-pabellon" name="Pabellon" required>
                                <option value="">Seleccionar pabellón</option>
                                @foreach (var p in ObjetoPerdido.Pabellones)
                                {
                                    <option>@p</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="rep-lugar">Lugar exacto</label>
                            <input class="form-control" id="rep-lugar" name="Lugar" maxlength="100" placeholder="Ej. Aula 204, baño 2do piso" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rep-fecha" id="lbl-rep-fecha">Fecha y hora del hallazgo</label>
                        <input class="form-control" id="rep-fecha" name="FechaHallazgo" type="datetime-local" required value="@ahora" max="@ahora" />
                    </div>
                    <div class="mb-3">
                        <span class="form-label d-block">Foto del objeto (opcional)</span>
                        <label class="dropzone">
                            <input type="file" name="Foto" accept=".jpg,.jpeg,.png,.webp" hidden data-dropzone data-preview="#rep-preview" />
                            <img id="rep-preview" class="rounded mb-2" style="max-height: 140px" alt="Vista previa" hidden />
                            <i class="bi bi-camera"></i>
                            <span data-dropzone-text>Arrastra o haz clic para subir imagen</span>
                        </label>
                    </div>
                    <div class="mb-3" id="campo-custodia">
                        <label class="form-label fw-bold" for="rep-custodia">Dónde lo dejaste o dejarás en custodia</label>
                        <select class="form-select" id="rep-custodia" name="Custodia">
                            <option value="">Seleccionar garita o secretaría</option>
                            @foreach (var c in Enum.GetValues<CustodiaObjeto>())
                            {
                                <option value="@c">@c.Nombre()</option>
                            }
                        </select>
                        <div class="form-text small">La garita específica no se publicará abiertamente; solo se le revelará al dueño cuando apruebes su reclamo.</div>
                    </div>
                    <div class="mb-3 d-none" id="campo-desc">
                        <label class="form-label" for="rep-desc">Señas particulares</label>
                        <textarea class="form-control" id="rep-desc" name="Descripcion" rows="2" maxlength="300" placeholder="Color, marca, stickers, contenido..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rep-wa" id="lbl-rep-wa">Número de WhatsApp (opcional)</label>
                        <div class="input-group">
                            <span class="input-group-text">+51</span>
                            <input class="form-control" id="rep-wa" name="WhatsApp" maxlength="9" inputmode="numeric"
                                   pattern="9[0-9]{8}" title="9 dígitos, empieza con 9" placeholder="987654321" />
                        </div>
                    </div>
                    <button class="btn-guinda w-100" id="btn-submit-reportar" type="submit">Publicar reporte</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reclamar pertenencia -->
<div class="modal fade" id="modalReclamar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">🙋 Reclamar Pertenencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="reclamo-resumen mb-3">
                    <div class="mini" data-rec="foto"><i class="bi bi-image"></i></div>
                    <div>
                        <div class="fw-bold" data-rec="titulo"></div>
                        <div class="small text-muted">📍 <span data-rec="lugar"></span></div>
                        <div class="small text-muted">📅 <span data-rec="fecha"></span></div>
                    </div>
                </div>
                <div class="alert alert-light border d-flex gap-2 align-items-start py-2 px-3 mb-3" style="background:#f8f9fa; border-radius:10px;">
                    <i class="bi bi-shield-lock text-primary fs-5 mt-1"></i>
                    <div class="small">
                        <strong class="text-dark">Procedimiento seguro de entrega FIA:</strong>
                        <div class="text-muted mt-1">
                            Para evitar reclamos falsos, describe a continuación características privadas que solo el dueño sabría (marcas, rayones, stickers, contenido). Si tu descripción coincide, el reportante aprobará tu solicitud y <strong>se te revelará la garita u oficina oficial</strong> para que lo retires con tu carné universitario.
                        </div>
                    </div>
                </div>
                <form asp-action="Reclamar" method="post">
                    <input type="hidden" name="ObjetoId" data-rec="id" />
                    <div class="mb-3">
                        <label class="form-label" for="rec-codigo">Código de alumno</label>
                        <input class="form-control" id="rec-codigo" name="CodigoAlumno" required pattern="[0-9]{10}" maxlength="10" inputmode="numeric"
                               title="10 dígitos" value="@Model.MiCodigo" placeholder="Ej. 2021123456" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rec-nombre">Nombre completo</label>
                        <input class="form-control" id="rec-nombre" name="NombreCompleto" required maxlength="120" value="@Model.MiNombre" placeholder="Según tu carné universitario" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="rec-desc">Describe el objeto para verificar que es tuyo</label>
                        <textarea class="form-control" id="rec-desc" name="Descripcion" rows="3" required minlength="15" maxlength="500"
                                  placeholder="Detalles específicos: color, modelo exacto, raspaduras, calcomanías, contenido..."></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="rec-wa">Número de WhatsApp</label>
                        <div class="input-group">
                            <span class="input-group-text">+51</span>
                            <input class="form-control" id="rec-wa" name="WhatsApp" required maxlength="9" inputmode="numeric"
                                   pattern="9[0-9]{8}" title="9 dígitos, empieza con 9" placeholder="987654321" />
                        </div>
                    </div>
                    <p class="small text-muted">Tu solicitud se enviará de forma confidencial al alumno que reportó el hallazgo.</p>
                    <button class="btn-guinda w-100" type="submit">Enviar solicitud de verificación</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function actualizarTipoReporte(tipo) {
            const esPerdido = (tipo === 'Perdido');
            const campoCustodia = document.getElementById('campo-custodia');
            const campoDesc = document.getElementById('campo-desc');
            const lblFecha = document.getElementById('lbl-rep-fecha');
            const lblWa = document.getElementById('lbl-rep-wa');
            const inputWa = document.getElementById('rep-wa');
            const selCustodia = document.getElementById('rep-custodia');
            const btnSubmit = document.getElementById('btn-submit-reportar');

            if (esPerdido) {
                campoCustodia.classList.add('d-none');
                selCustodia.removeAttribute('required');
                campoDesc.classList.remove('d-none');
                lblFecha.textContent = "¿Cuándo lo perdiste?";
                lblWa.textContent = "Número de WhatsApp (Obligatorio)";
                inputWa.setAttribute('required', 'required');
                btnSubmit.textContent = "Publicar objeto perdido";
            } else {
                campoCustodia.classList.remove('d-none');
                selCustodia.setAttribute('required', 'required');
                campoDesc.classList.add('d-none');
                lblFecha.textContent = "Fecha y hora del hallazgo";
                lblWa.textContent = "Número de WhatsApp (Opcional)";
                inputWa.removeAttribute('required');
                btnSubmit.textContent = "Reportar objeto encontrado";
            }
        }

        // Modal "Reclamar"
        document.getElementById('modalReclamar').addEventListener('show.bs.modal', e => {
            const d = e.relatedTarget.dataset;
            const modal = e.target;
            const campo = k => modal.querySelector(`[data-rec="${k}"]`);
            campo('id').value = d.id;
            campo('titulo').textContent = d.titulo;
            campo('lugar').textContent = d.lugar;
            campo('fecha').textContent = d.fecha;
            const foto = campo('foto');
            foto.replaceChildren();
            if (d.foto) {
                const img = document.createElement('img');
                img.src = d.foto;
                img.alt = '';
                foto.append(img);
            } else {
                foto.innerHTML = '<i class="bi bi-image"></i>';
            }
        });
    </script>
}
