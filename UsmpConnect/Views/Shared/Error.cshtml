@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    if (User.Identity?.IsAuthenticated != true)
    {
        Layout = "_LayoutAuth";
    }
}
<div class="card-u estado">
    <div class="icono"><i class="bi bi-exclamation-triangle"></i></div>
    <h1 class="h4 fw-bold">Ocurrió un error inesperado</h1>
    <p class="text-muted">Intenta nuevamente. Si el problema continúa, avísanos.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="small text-muted">Código de seguimiento: <code>@Model.RequestId</code></p>
    }
    <a href="/" class="btn-guinda d-inline-block mt-2">Volver al inicio</a>
</div>
