<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · USMP Connect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <section class="auth-side">
            <a class="brand" href="/"><span class="brand-logo">M</span> MI USMP HUB</a>
            <div style="position:relative;z-index:1">
                <span class="hero-tag">PERIODO 2026-II</span>
                <h1 class="mt-3">USMP Connect</h1>
                <p class="opacity-75 mb-0">Todo lo que necesitas en la universidad, en un solo lugar.</p>
                <ul class="auth-features">
                    <li><i class="bi bi-journal-check"></i><div><b>Notas y horarios</b><br><small class="opacity-75">Tus docentes registran notas y te llega la notificación al instante.</small></div></li>
                    <li><i class="bi bi-lightbulb"></i><div><b>Cátedra & Tips</b><br><small class="opacity-75">Consejos reales de alumnos por curso y por docente.</small></div></li>
                    <li><i class="bi bi-bag"></i><div><b>Marketplace y Lost & Found</b><br><small class="opacity-75">Compra, vende, dona y recupera lo que perdiste en el campus.</small></div></li>
                </ul>
            </div>
            <small class="opacity-50" style="position:relative;z-index:1">Proyecto académico · Programación I</small>
        </section>
        <section class="auth-form">
            <div class="inner">
                @RenderBody()
            </div>
        </section>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
