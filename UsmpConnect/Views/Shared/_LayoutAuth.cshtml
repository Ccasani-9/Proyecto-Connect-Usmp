<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · USMP Connect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <section class="auth-side">
            <a class="brand d-flex align-items-center gap-3" href="/">
                <img src="~/img/logo_USMP-CONNECT.png" alt="USMP Connect Logo" style="width:70px; height:70px; object-fit:contain;" />
                <span style="font-size:1.45rem; font-weight:800; letter-spacing:0.5px;">USMP CONNECT</span>
            </a>
            <div style="position:relative;z-index:1">
                <span class="hero-tag">PERIODO 2026-II</span>
                <h1 class="mt-3">USMP Connect</h1>
                <p class="opacity-75 mb-0">La red comunitaria de vida universitaria en la FIA.</p>
                <ul class="auth-features">
                    <li><i class="bi bi-geo-alt-fill"></i><div><b>Restaurantes &amp; Food Spots FIA</b><br><small class="opacity-75">Guía gastronómica perimetral con menús diarios y precios para alumnos.</small></div></li>
                    <li><i class="bi bi-lightbulb"></i><div><b>Cátedra &amp; Tips</b><br><small class="opacity-75">Consejos reales de alumnos por curso y por docente para aprobar.</small></div></li>
                    <li><i class="bi bi-bag"></i><div><b>Marketplace y Objetos Perdidos</b><br><small class="opacity-75">Compra, venta de materiales y pertenencias custodiadas en campus.</small></div></li>
                </ul>
            </div>
            <small class="opacity-75" style="position:relative;z-index:1">Facultad de Ingeniería y Arquitectura · FIA USMP</small>
        </section>
        <section class="auth-form">
            <div class="inner">
                @RenderBody()
            </div>
        </section>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
