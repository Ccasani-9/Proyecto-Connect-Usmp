@using UsmpConnect.Models
@using UsmpConnect.Services
@model UsmpConnect.ViewModels.FoodSpotsIndexVM
@{
    ViewData["Title"] = "Restaurantes Cercanos";
}

@section Styles {
    <style>
        .food-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.25rem;
        }
        .food-card {
            border: 1px solid var(--border, #e5e7eb);
            border-radius: 1rem;
            overflow: hidden;
            background: #fff;
            transition: transform .2s ease, box-shadow .2s ease;
            display: flex;
            flex-direction: column;
        }
        .food-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,.08);
        }
        .food-card-img {
            height: 165px;
            width: 100%;
            object-fit: cover;
            position: relative;
        }
        .food-card-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .stars-gold {
            color: #f59e0b;
        }
        #mapa-fia {
            height: 400px;
            width: 100%;
            border-radius: 1rem;
            border: 1px solid var(--border, #e5e7eb);
            box-shadow: 0 4px 12px rgba(0,0,0,.04);
            z-index: 10;
        }
    </style>
}

<div class="card-u page-head mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="h3 fw-bold mb-0">Restaurantes Cercanos a la FIA</h1>
            <span class="tag tag-guinda"><i class="bi bi-geo-alt-fill me-1"></i>Av. La Fontana 1250</span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size:0.75rem;">
                <i class="bi bi-google me-1"></i>Google Maps &amp; Places
            </span>
        </div>
        <p class="text-muted mb-0">Huariques, cafeterías y locales gastronómicos reales alrededor del campus universitario FIA USMP.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-secondary border px-3 py-2" style="font-size: .84rem; font-weight: 600;">
            <i class="bi bi-compass me-1 text-danger"></i>Guía Estudiantil FIA
        </span>
    </div>
</div>

<!-- Mapa Interactivo Oficial Google Maps -->
<div class="card-u p mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
            <h2 class="h5 fw-bold mb-0">Mapa Interactivo de Locales y Huariques</h2>
            <small class="text-muted">(Av. La Fontana, Av. Flora Tristán, Av. Los Constructores)</small>
        </div>
        <button class="btn btn-sm btn-soft" type="button" onclick="centrarEnFia()">
            <i class="bi bi-crosshair me-1"></i>Centrar en Campus FIA
        </button>
    </div>
    <div id="mapa-fia"></div>
</div>

<!-- Filtros y Búsqueda -->
<div class="card-u p mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-lg-5">
            <form method="get" class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="q" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre, chifa, cafetería..." />
                @if (Model.CategoriaActual.HasValue)
                {
                    <input type="hidden" name="categoria" value="@Model.CategoriaActual" />
                }
            </form>
        </div>
        <div class="col-lg-7">
            <div class="chips d-flex flex-wrap gap-1">
                <a href="@Url.Action("Index", new { q = Model.Busqueda })" class="chip @(Model.CategoriaActual == null ? "active" : "")">Todos (@Model.Restaurantes.Count)</a>
                @foreach (CategoriaRestaurante cat in Enum.GetValues(typeof(CategoriaRestaurante)))
                {
                    var activa = Model.CategoriaActual == cat;
                    <a href="@Url.Action("Index", new { categoria = cat, q = Model.Busqueda })" class="chip @(activa ? "active" : "")">
                        @cat.Nombre()
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Grilla de Restaurantes -->
@if (Model.Restaurantes.Count == 0)
{
    <div class="card-u p text-center py-5">
        <i class="bi bi-shop fs-1 text-muted mb-2"></i>
        <h4>No se encontraron locales</h4>
        <p class="text-muted">Intenta buscar con otro término o selecciona otra categoría.</p>
        <a href="/Restaurantes" class="btn btn-sm btn-guinda">Ver todos los locales</a>
    </div>
}
else
{
    <div class="food-grid">
        @foreach (var r in Model.Restaurantes)
        {
            <div class="food-card" id="card-rest-@r.Id">
                <div class="position-relative">
                    <img src="@r.FotoUrl" class="food-card-img" alt="@r.Nombre" loading="lazy" />
                    <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2" style="backdrop-filter: blur(4px);">
                        @r.Categoria.Nombre()
                    </span>
                    <span class="badge bg-white text-dark shadow-sm position-absolute top-0 end-0 m-2 fw-semibold">
                        <i class="bi bi-star-fill text-warning me-1"></i>@r.CalificacionPromedio.ToString("0.0")
                    </span>
                </div>
                <div class="food-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h3 class="h5 fw-bold mb-0">@r.Nombre</h3>
                    </div>
                    <div class="d-flex align-items-center gap-1 mb-2">
                        <span class="stars-gold">
                            @for (var i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star@(i <= Math.Round(r.CalificacionPromedio) ? "-fill" : "")"></i>
                            }
                        </span>
                        <small class="fw-bold ms-1">@r.CalificacionPromedio.ToString("0.0")</small>
                        <small class="text-muted">(@r.TotalResenas @(r.TotalResenas == 1 ? "reseña" : "reseñas"))</small>
                    </div>

                    <p class="small text-muted mb-3 text-truncate-2" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:36px; line-height:1.35;">
                        @r.Descripcion
                    </p>

                    <div class="small text-muted mb-3 pt-2 border-top">
                        <div class="mb-1 text-truncate"><i class="bi bi-pin-map text-secondary me-1"></i>@r.Direccion</div>
                        <div class="text-truncate"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@r.DistanciaTexto · <span class="text-success fw-semibold"><i class="bi bi-clock me-1"></i>@r.HorarioAtencion</span></div>
                    </div>

                    <div class="mt-auto d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary w-50" type="button" onclick="irARestauranteEnMapa(@r.Latitud, @r.Longitud, '@r.Nombre.Replace("'", "\\'")')">
                            <i class="bi bi-pin-map me-1"></i>Ver en mapa
                        </button>
                        <button class="btn btn-sm btn-guinda w-50" type="button" onclick="abrirModalDetalle(@r.Id)">
                            <i class="bi bi-chat-heart me-1"></i>Ver reseñas
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Detalle del Restaurante / Reseñas de Alumnos -->
<div class="modal fade" id="modalRestaurante" tabindex="-1" aria-labelledby="modalRestauranteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h5 fw-bold mb-0" id="modalRestauranteLabel">Detalle del Restaurante</h2>
                    <span id="modalDistancia" class="small text-muted"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <img id="modalImg" src="" class="w-100 rounded object-fit-cover shadow-sm" style="max-height: 220px;" alt="Restaurante" />
                        <div class="mt-2 text-center" id="modalBtnWaContainer"></div>
                    </div>
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span id="modalCategoria" class="tag tag-guinda"></span>
                            <div class="d-flex align-items-center ms-auto">
                                <span class="stars-gold"><i class="bi bi-star-fill"></i></span>
                                <span id="modalPromedio" class="fw-bold ms-1"></span>
                                <span id="modalTotalResenas" class="text-muted small ms-1"></span>
                            </div>
                        </div>
                        <p id="modalDesc" class="text-muted small mb-2"></p>
                        <div class="small bg-light p-2 rounded mb-2">
                            <div class="mb-1"><i class="bi bi-pin-map text-secondary me-1"></i><span id="modalDireccion"></span></div>
                            <div><i class="bi bi-clock me-1 text-primary"></i><span id="modalHorario"></span></div>
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Reseñas -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold mb-0"><i class="bi bi-chat-heart me-1"></i>Opiniones de la Comunidad USMP</h3>
                    <button class="btn btn-sm btn-soft" type="button" data-bs-toggle="collapse" data-bs-target="#formResenaCollapse">
                        <i class="bi bi-pencil-fill me-1"></i>Escribir reseña
                    </button>
                </div>

                <!-- Formulario desplegable para nueva reseña -->
                <div class="collapse mb-4" id="formResenaCollapse">
                    <form asp-action="Resenar" method="post" class="card-u p bg-light">
                        <input type="hidden" name="RestauranteId" id="formRestauranteId" value="" />
                        <h4 class="h6 fw-bold mb-2">Tu calificación como alumno FIA</h4>
                        <div class="row g-2 mb-2">
                            <div class="col-sm-4">
                                <label class="form-label small fw-semibold">Puntuación:</label>
                                <select name="Puntuacion" class="form-select form-select-sm">
                                    <option value="5">⭐⭐⭐⭐⭐ (5 - Excelente)</option>
                                    <option value="4">⭐⭐⭐⭐ (4 - Muy bueno)</option>
                                    <option value="3">⭐⭐⭐ (3 - Bueno)</option>
                                    <option value="2">⭐⭐ (2 - Regular)</option>
                                    <option value="1">⭐ (1 - Malo)</option>
                                </select>
                            </div>
                            <div class="col-sm-8">
                                <label class="form-label small fw-semibold">Comentario:</label>
                                <input type="text" name="Comentario" class="form-control form-control-sm" placeholder="Ej: Atención rápida, ambiente agradable entre clases..." required minlength="5" maxlength="500" />
                            </div>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-sm btn-guinda">Publicar Reseña</button>
                        </div>
                    </form>
                </div>

                <!-- Muro de Reseñas -->
                <div id="modalResenasLista"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Google Maps JavaScript API oficial -->
    <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&callback=initGoogleMap" async defer></script>
    <script>
        let map;
        let infoWindow;
        const fiaCoords = { lat: -12.07203, lng: -76.94205 };
        const marcadores = {};

        const restos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Restaurantes.Select(r => new {
            r.Id,
            r.Nombre,
            r.Latitud,
            r.Longitud,
            r.DistanciaTexto,
            r.HorarioAtencion,
            r.Direccion,
            r.CalificacionPromedio,
            r.TotalResenas,
            r.FotoUrl
        })));

        function initGoogleMap() {
            infoWindow = new google.maps.InfoWindow();

            // Mapa centrado en el campus FIA USMP
            map = new google.maps.Map(document.getElementById("mapa-fia"), {
                zoom: 16,
                center: fiaCoords,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: true,
                styles: [
                    { featureType: "poi.school", elementType: "labels", stylers: [{ visibility: "on" }] },
                    { featureType: "poi.business", elementType: "labels", stylers: [{ visibility: "on" }] }
                ]
            });

            // Marcador especial Campus USMP FIA
            const fiaMarker = new google.maps.Marker({
                position: fiaCoords,
                map: map,
                title: "Facultad de Ingeniería y Arquitectura (FIA) - USMP",
                icon: {
                    path: google.maps.SymbolPath.CIRCLE,
                    scale: 11,
                    fillColor: "#7a152d",
                    fillOpacity: 1,
                    strokeColor: "#ffffff",
                    strokeWeight: 3
                }
            });

            fiaMarker.addListener("click", () => {
                infoWindow.setContent(`
                    <div style="padding:6px; font-family:Inter,sans-serif;">
                        <span style="background:#7a152d; color:#fff; font-size:10px; font-weight:700; padding:2px 6px; border-radius:4px;">CAMPUS FIA</span>
                        <h4 style="font-size:13px; font-weight:700; margin:4px 0 2px 0;">Facultad de Ingeniería y Arquitectura</h4>
                        <p style="font-size:11px; color:#6b7280; margin:0;">Av. La Fontana 1250, Santa Patricia - La Molina</p>
                    </div>
                `);
                infoWindow.open(map, fiaMarker);
            });

            // Marcadores de restaurantes
            restos.forEach(r => {
                const marker = new google.maps.Marker({
                    position: { lat: r.Latitud, lng: r.Longitud },
                    map: map,
                    title: r.Nombre,
                    icon: {
                        path: google.maps.SymbolPath.BACKWARD_CLOSED_ARROW,
                        scale: 5,
                        fillColor: "#ea580c",
                        fillOpacity: 1,
                        strokeColor: "#ffffff",
                        strokeWeight: 1.5
                    }
                });

                marker.addListener("click", () => {
                    infoWindow.setContent(`
                        <div style="max-width:210px; font-family:Inter,sans-serif; padding:4px;">
                            <img src="${r.FotoUrl}" style="width:100%; height:85px; object-fit:cover; border-radius:6px; margin-bottom:6px;" alt="${r.Nombre}" />
                            <b style="font-size:12px; display:block;">${r.Nombre}</b>
                            <div style="font-size:11px; color:#f59e0b; margin:2px 0;">★ ${r.CalificacionPromedio.toFixed(1)} (${r.TotalResenas} reseñas)</div>
                            <small style="color:#6b7280; display:block; margin-bottom:6px;">📍 ${r.DistanciaTexto}</small>
                            <button onclick="abrirModalDetalle(${r.Id})" class="btn btn-sm btn-guinda w-100" style="font-size:11px; padding:3px 8px;">Ver Reseñas</button>
                        </div>
                    `);
                    infoWindow.open(map, marker);
                });

                marcadores[r.Id] = marker;
            });
        }

        function centrarEnFia() {
            if (map) {
                map.setZoom(16);
                map.panTo(fiaCoords);
            }
        }

        function irARestauranteEnMapa(lat, lng, nombre) {
            if (map) {
                const pos = { lat: lat, lng: lng };
                map.setZoom(18);
                map.panTo(pos);
                document.getElementById('mapa-fia').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        async function abrirModalDetalle(id) {
            try {
                const res = await fetch(`/Restaurantes/Detalle/${id}`);
                if (!res.ok) return;
                const d = await res.json();

                document.getElementById('modalRestauranteLabel').textContent = d.nombre;
                document.getElementById('modalDistancia').textContent = `${d.distanciaTexto} · ${d.direccion}`;
                document.getElementById('modalImg').src = d.fotoUrl;
                document.getElementById('modalCategoria').textContent = d.categoria;
                document.getElementById('modalPromedio').textContent = d.calificacionPromedio.toFixed(1);
                document.getElementById('modalTotalResenas').textContent = `(${d.totalResenas} reseñas)`;
                document.getElementById('modalDesc').textContent = d.descripcion;
                document.getElementById('modalDireccion').textContent = d.direccion;
                document.getElementById('modalHorario').textContent = d.horarioAtencion;
                document.getElementById('formRestauranteId').value = d.id;

                if (d.telefonoWhatsApp) {
                    document.getElementById('modalBtnWaContainer').innerHTML = `
                        <a href="https://wa.me/51${d.telefonoWhatsApp}?text=Hola,%20soy%20estudiante%20de%20la%20USMP%20FIA,%20deseo%20hacer%20una%20consulta." target="_blank" class="btn btn-sm btn-wa w-100">
                            <i class="bi bi-whatsapp me-1"></i>Contactar por WhatsApp
                        </a>
                    `;
                } else {
                    document.getElementById('modalBtnWaContainer').innerHTML = '';
                }

                // Reseñas de estudiantes
                const listaResenas = document.getElementById('modalResenasLista');
                if (d.resenas && d.resenas.length > 0) {
                    listaResenas.innerHTML = d.resenas.map(r => `
                        <div class="p-2 border rounded mb-2 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar avatar-sm avatar-soft">${r.iniciales}</span>
                                    <span class="fw-semibold small">${r.autor}</span>
                                </div>
                                <span class="text-muted small">${r.fechaRelativa}</span>
                            </div>
                            <div class="stars-gold mb-1" style="font-size:12px;">
                                ${'★'.repeat(r.puntuacion)}${'☆'.repeat(5 - r.puntuacion)}
                            </div>
                            <p class="small mb-0 text-secondary">${r.comentario}</p>
                        </div>
                    `).join('');
                } else {
                    listaResenas.innerHTML = '<p class="text-muted small">Aún no hay reseñas. ¡Sé el primer estudiante en calificar este local!</p>';
                }

                const modal = new bootstrap.Modal(document.getElementById('modalRestaurante'));
                modal.show();
            } catch (err) {
                console.error("Error al cargar detalle:", err);
            }
        }
    </script>
}
