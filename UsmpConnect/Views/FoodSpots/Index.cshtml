@using UsmpConnect.Models
@using UsmpConnect.Services
@model UsmpConnect.ViewModels.FoodSpotsIndexVM
@{
    ViewData["Title"] = "Restaurantes Cercanos";
}

@section Styles {
    <style>
        .food-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 1.25rem;
        }
        .food-card {
            border: 1px solid var(--border, #e5e7eb);
            border-radius: 1rem;
            overflow: hidden;
            background: #fff;
            transition: transform .2s ease, box-shadow .2s ease;
            display: flex;
            flex-direction: column;
        }
        .food-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,.08);
        }
        .food-card-img {
            height: 175px;
            width: 100%;
            object-fit: cover;
            position: relative;
            background-color: #f3f4f6;
        }
        .food-card-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .stars-gold {
            color: #f59e0b;
        }
        #mapa-fia {
            height: 430px;
            width: 100%;
            border-radius: 1rem;
            border: 1px solid var(--border, #e5e7eb);
            box-shadow: 0 4px 12px rgba(0,0,0,.04);
            z-index: 10;
        }
        .dist-filter-btn.active {
            background-color: #7a152d !important;
            color: #fff !important;
            border-color: #7a152d !important;
        }
    </style>
}

<div class="card-u page-head mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h1 class="h3 fw-bold mb-0">Restaurantes Cercanos a la FIA</h1>
            <span class="tag tag-guinda"><i class="bi bi-geo-alt-fill me-1"></i>Av. La Fontana 1250</span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size:0.75rem;">
                <i class="bi bi-google me-1"></i>Google Maps &amp; Places
            </span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size:0.75rem;">
                <i class="bi bi-camera-fill me-1"></i>Fotos Reales de Locales
            </span>
        </div>
        <p class="text-muted mb-0">Directorio universitario interactivo con todos los restaurantes, cafeterías y huariques reales alrededor del campus FIA USMP.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-secondary border px-3 py-2" style="font-size: .84rem; font-weight: 600;">
            <i class="bi bi-compass me-1 text-danger"></i>@Model.Restaurantes.Count Locales Reconocidos
        </span>
    </div>
</div>

<!-- Mapa Interactivo Oficial Google Maps -->
<div class="card-u p mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
            <h2 class="h5 fw-bold mb-0">Mapa Interactivo Alrededor de la FIA</h2>
            <small class="text-muted">(Cuadrante: Flora Tristán · Javier Prado · La Fontana · Los Ingenieros)</small>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Filtro por zona dentro del cuadrante -->
            <div class="btn-group btn-group-sm" role="group" aria-label="Filtro de zona">
                <button type="button" class="btn btn-outline-secondary dist-filter-btn active" onclick="filtrarPorZona('todos', this)">
                    <i class="bi bi-grid-fill me-1"></i>Todo el Cuadrante (@Model.Restaurantes.Count)
                </button>
                <button type="button" class="btn btn-outline-secondary dist-filter-btn" onclick="filtrarPorZona('fontana', this)">
                    Av. La Fontana
                </button>
                <button type="button" class="btn btn-outline-secondary dist-filter-btn" onclick="filtrarPorZona('flora', this)">
                    Av. Flora Tristán
                </button>
            </div>

            <!-- Controles de vista del mapa -->
            <button class="btn btn-sm btn-soft" type="button" onclick="verCuadranteCompleto()" title="Ver panorama completo del cuadrante recortado">
                <i class="bi bi-aspect-ratio me-1 text-primary"></i>Ver Panorama
            </button>
            <button class="btn btn-sm btn-soft" type="button" onclick="miUbicacion()" title="Ver tu ubicación GPS actual">
                <i class="bi bi-cursor-fill text-primary me-1"></i>Mi Ubicación
            </button>
            <button class="btn btn-sm btn-soft" type="button" onclick="centrarEnFia()" title="Enfocar puerta principal Campus FIA">
                <i class="bi bi-crosshair me-1 text-danger"></i>Campus FIA
            </button>
        </div>
    </div>
    <div id="mapa-fia"></div>
</div>

<!-- Filtros y Búsqueda -->
<div class="card-u p mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-lg-5">
            <form method="get" class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" name="q" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre, chifa, café, pasta..." />
                @if (Model.CategoriaActual.HasValue)
                {
                    <input type="hidden" name="categoria" value="@Model.CategoriaActual" />
                }
            </form>
        </div>
        <div class="col-lg-7">
            <div class="chips d-flex flex-wrap gap-1">
                <a href="@Url.Action("Index", new { q = Model.Busqueda })" class="chip @(Model.CategoriaActual == null ? "active" : "")">Todos (@Model.Restaurantes.Count)</a>
                @foreach (CategoriaRestaurante cat in Enum.GetValues(typeof(CategoriaRestaurante)))
                {
                    var activa = Model.CategoriaActual == cat;
                    <a href="@Url.Action("Index", new { categoria = cat, q = Model.Busqueda })" class="chip @(activa ? "active" : "")">
                        @cat.Nombre()
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Grilla de Restaurantes -->
@if (Model.Restaurantes.Count == 0)
{
    <div class="card-u p text-center py-5">
        <i class="bi bi-shop fs-1 text-muted mb-2"></i>
        <h4>No se encontraron locales</h4>
        <p class="text-muted">Intenta buscar con otro término o selecciona otra categoría.</p>
        <a href="/Restaurantes" class="btn btn-sm btn-guinda">Ver todos los locales</a>
    </div>
}
else
{
    <div class="food-grid" id="food-grid-container">
        @foreach (var r in Model.Restaurantes)
        {
            var walkingUrl = $"https://www.google.com/maps/dir/?api=1&origin=-12.07203,-76.94205&destination={r.Latitud.ToString(System.Globalization.CultureInfo.InvariantCulture)},{r.Longitud.ToString(System.Globalization.CultureInfo.InvariantCulture)}&travelmode=walking";

            <div class="food-card" id="card-rest-@r.Id" data-lat="@r.Latitud.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-lng="@r.Longitud.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <div class="position-relative">
                    <img src="@r.FotoUrl" class="food-card-img" alt="@r.Nombre" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=600';" />
                    <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2" style="backdrop-filter: blur(4px);">
                        @r.Categoria.Nombre()
                    </span>
                    <span class="badge bg-white text-dark shadow-sm position-absolute top-0 end-0 m-2 fw-semibold">
                        <i class="bi bi-star-fill text-warning me-1"></i>@r.CalificacionPromedio.ToString("0.0")
                    </span>
                </div>
                <div class="food-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h3 class="h5 fw-bold mb-0">@r.Nombre</h3>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-1">
                            <span class="stars-gold">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= Math.Round(r.CalificacionPromedio) ? "-fill" : "")"></i>
                                }
                            </span>
                            <small class="fw-bold ms-1">@r.CalificacionPromedio.ToString("0.0")</small>
                            <small class="text-muted">(@r.TotalResenas @(r.TotalResenas == 1 ? "reseña" : "reseñas"))</small>
                        </div>
                        <span class="badge bg-light text-secondary border">@r.RangoPrecios</span>
                    </div>

                    <p class="small text-muted mb-3 text-truncate-2" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:36px; line-height:1.35;">
                        @r.Descripcion
                    </p>

                    <div class="small text-muted mb-3 pt-2 border-top">
                        <div class="mb-1 text-truncate"><i class="bi bi-pin-map text-secondary me-1"></i>@r.Direccion</div>
                        <div class="text-truncate">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@r.DistanciaTexto
                            <span class="text-success fw-semibold ms-1"><i class="bi bi-clock me-1"></i>@r.HorarioAtencion</span>
                        </div>
                    </div>

                    <div class="mt-auto pt-2">
                        <div class="d-flex gap-2 mb-2">
                            <button class="btn btn-sm btn-outline-secondary w-50" type="button" onclick="irARestauranteEnMapa(@r.Id)">
                                <i class="bi bi-pin-map me-1"></i>Ver en mapa
                            </button>
                            <button class="btn btn-sm btn-guinda w-50" type="button" onclick="abrirModalDetalle(@r.Id)">
                                <i class="bi bi-chat-heart me-1"></i>Reseñas (@r.TotalResenas)
                            </button>
                        </div>
                        <a href="@walkingUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary w-100" title="Ver ruta a pie exacta desde el campus FIA en Google Maps">
                            <i class="bi bi-person-walking me-1"></i>Cómo llegar a pie
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Detalle del Restaurante / Reseñas de Alumnos -->
<div class="modal fade" id="modalRestaurante" tabindex="-1" aria-labelledby="modalRestauranteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title h5 fw-bold mb-0" id="modalRestauranteLabel">Detalle del Restaurante</h2>
                    <span id="modalDistancia" class="small text-muted"></span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <img id="modalImg" src="" class="w-100 rounded object-fit-cover shadow-sm" style="max-height: 220px;" alt="Restaurante" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=600';" />
                        <div class="mt-2 d-flex flex-column gap-1" id="modalLinksContainer">
                            <a id="modalBtnRuta" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-person-walking me-1"></i>Cómo llegar a pie (Google Maps)
                            </a>
                            <a id="modalBtnGmaps" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary w-100">
                                <i class="bi bi-google me-1 text-danger"></i>Ver ficha en Google Maps
                            </a>
                            <div id="modalBtnWaContainer"></div>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span id="modalCategoria" class="tag tag-guinda"></span>
                            <span id="modalRangoPrecios" class="badge bg-light text-secondary border"></span>
                            <div class="d-flex align-items-center ms-auto">
                                <span class="stars-gold"><i class="bi bi-star-fill"></i></span>
                                <span id="modalPromedio" class="fw-bold ms-1"></span>
                                <span id="modalTotalResenas" class="text-muted small ms-1"></span>
                            </div>
                        </div>
                        <p id="modalDesc" class="text-muted small mb-2"></p>
                        <div class="small bg-light p-2 rounded mb-2">
                            <div class="mb-1"><i class="bi bi-pin-map text-secondary me-1"></i><span id="modalDireccion"></span></div>
                            <div><i class="bi bi-clock me-1 text-primary"></i><span id="modalHorario"></span></div>
                        </div>
                    </div>
                </div>

                <hr class="my-3" />

                <!-- Reseñas de Alumnos USMP -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h6 fw-bold mb-0"><i class="bi bi-chat-heart me-1"></i>Opiniones de la Comunidad USMP</h3>
                    <button class="btn btn-sm btn-soft" type="button" data-bs-toggle="collapse" data-bs-target="#formResenaCollapse">
                        <i class="bi bi-pencil-fill me-1"></i>Escribir reseña
                    </button>
                </div>

                <!-- Formulario desplegable para nueva reseña -->
                <div class="collapse mb-4" id="formResenaCollapse">
                    <form asp-action="Resenar" method="post" class="card-u p bg-light">
                        <input type="hidden" name="RestauranteId" id="formRestauranteId" value="" />
                        <h4 class="h6 fw-bold mb-2">Tu calificación como alumno FIA</h4>
                        <div class="row g-2 mb-2">
                            <div class="col-sm-4">
                                <label class="form-label small fw-semibold">Puntuación:</label>
                                <select name="Puntuacion" class="form-select form-select-sm">
                                    <option value="5">⭐⭐⭐⭐⭐ (5 - Excelente)</option>
                                    <option value="4">⭐⭐⭐⭐ (4 - Muy bueno)</option>
                                    <option value="3">⭐⭐⭐ (3 - Bueno)</option>
                                    <option value="2">⭐⭐ (2 - Regular)</option>
                                    <option value="1">⭐ (1 - Malo)</option>
                                </select>
                            </div>
                            <div class="col-sm-8">
                                <label class="form-label small fw-semibold">Comentario:</label>
                                <input type="text" name="Comentario" class="form-control form-control-sm" placeholder="Ej: Atención rápida, ambiente agradable entre clases..." required minlength="5" maxlength="500" />
                            </div>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-sm btn-guinda">Publicar Reseña</button>
                        </div>
                    </form>
                </div>

                <!-- Muro de Reseñas -->
                <div id="modalResenasLista"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Google Maps JavaScript API oficial -->
    <script src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleMapsApiKey&callback=initGoogleMap" async defer></script>
    <script>
        let map;
        let infoWindow;
        let userMarker = null;
        const fiaCoords = { lat: -12.07203, lng: -76.94205 };
        const marcadores = {};

        // Paleta de colores temáticos por categoría de local
        const categoriaColores = {
            "MenuCriollo": "#ea580c",        // Naranja peruano
            "ComidaRapida": "#f59e0b",       // Ámbar
            "Chifa": "#dc2626",              // Rojo oriental
            "CafeteriaHuarique": "#78350f",   // Café tostado
            "PasteleriaPostres": "#db2777",   // Rosa pastelería
            "Saludable": "#16a34a"           // Verde fresco
        };

        const restos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Restaurantes.Select(r => new {
            r.Id,
            r.Nombre,
            CategoriaKey = r.Categoria.ToString(),
            CategoriaNombre = r.Categoria.Nombre(),
            r.Latitud,
            r.Longitud,
            r.DistanciaTexto,
            r.HorarioAtencion,
            r.Direccion,
            r.CalificacionPromedio,
            r.TotalResenas,
            r.FotoUrl
        })));

        // Límites exactos del cuadrante universitario: Flora Tristán - Javier Prado - La Fontana - Los Ingenieros
        const boundsCuadranteFIA = {
            north: -12.0655,  // Av. Javier Prado Este
            south: -12.0745,  // Av. La Fontana
            west: -76.9500,   // Av. Los Ingenieros
            east: -76.9385    // Av. Flora Tristán
        };

        // Límites de navegación con margen holgado para que el auto-pan nunca tope con una pared rígida
        const boundsNavegacion = {
            north: -12.0590,  // Margen norte holgado para que la ventanita entre completa
            south: -12.0790,
            west: -76.9550,
            east: -76.9330
        };

        function initGoogleMap() {
            infoWindow = new google.maps.InfoWindow();

            // Mapa enfocado en el cuadrante del Campus FIA
            map = new google.maps.Map(document.getElementById("mapa-fia"), {
                zoom: 15.6,
                minZoom: 13.8,
                maxZoom: 19,
                center: { lat: -12.0708, lng: -76.9430 },
                restriction: {
                    latLngBounds: boundsNavegacion,
                    strictBounds: false
                },
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: true,
                styles: [
                    { featureType: "poi.school", elementType: "labels", stylers: [{ visibility: "on" }] },
                    { featureType: "poi.business", elementType: "labels", stylers: [{ visibility: "on" }] }
                ]
            });

            // Enmarcar y delimitar visualmente el área del cuadrante universitario
            const cuadrantePoligono = [
                { lat: -12.0655, lng: -76.9500 }, // Javier Prado con Los Ingenieros
                { lat: -12.0655, lng: -76.9385 }, // Javier Prado con Flora Tristán
                { lat: -12.0745, lng: -76.9385 }, // La Fontana con Flora Tristán
                { lat: -12.0745, lng: -76.9500 }  // La Fontana con Los Ingenieros
            ];

            new google.maps.Polygon({
                paths: cuadrantePoligono,
                strokeColor: "#7a152d",
                strokeOpacity: 0.65,
                strokeWeight: 2,
                fillColor: "#7a152d",
                fillOpacity: 0.02,
                map: map
            });

            // Ajustar automáticamente la vista para mostrar todo el panorama del cuadrante en pantalla
            map.fitBounds(boundsCuadranteFIA);

            // Marcador especial Campus USMP FIA
            const fiaMarker = new google.maps.Marker({
                position: fiaCoords,
                map: map,
                title: "Facultad de Ingeniería y Arquitectura (FIA) - USMP",
                zIndex: 999,
                icon: {
                    path: google.maps.SymbolPath.CIRCLE,
                    scale: 11,
                    fillColor: "#7a152d",
                    fillOpacity: 1,
                    strokeColor: "#ffffff",
                    strokeWeight: 3
                }
            });

            fiaMarker.addListener("click", () => {
                infoWindow.setContent(`
                    <div style="padding:6px; font-family:Inter,sans-serif;">
                        <span style="background:#7a152d; color:#fff; font-size:10px; font-weight:700; padding:2px 6px; border-radius:4px;">CAMPUS FIA</span>
                        <h4 style="font-size:13px; font-weight:700; margin:4px 0 2px 0;">Facultad de Ingeniería y Arquitectura</h4>
                        <p style="font-size:11px; color:#6b7280; margin:0;">Av. La Fontana 1250, Santa Patricia - La Molina</p>
                    </div>
                `);
                infoWindow.open(map, fiaMarker);
            });

            // Marcadores para cada uno de los restaurantes
            restos.forEach(r => {
                const colorMarker = categoriaColores[r.CategoriaKey] || "#ea580c";

                const marker = new google.maps.Marker({
                    position: { lat: r.Latitud, lng: r.Longitud },
                    map: map,
                    title: r.Nombre,
                    icon: {
                        path: google.maps.SymbolPath.BACKWARD_CLOSED_ARROW,
                        scale: 5,
                        fillColor: colorMarker,
                        fillOpacity: 1,
                        strokeColor: "#ffffff",
                        strokeWeight: 1.5
                    }
                });

                marker.addListener("click", () => {
                    abrirInfoWindowRestaurante(r, marker);
                });

                marcadores[r.Id] = marker;
            });
        }

        // Abre la ventanita del restaurante asegurando que se dibuje 100% ADENTRO del mapa sin recortarse
        function abrirInfoWindowRestaurante(r, marker) {
            if (!map || !r || !marker) return;

            // Si el restaurante está en el norte (Av. Javier Prado), desplazamos la cámara hacia arriba
            // para que el marcador baje y la ventanita flote adentro con holgura total
            let offsetLat = 0.0016;
            if (r.Latitud > -12.0690) {
                offsetLat = 0.0028; // Zona Javier Prado
            } else if (r.Latitud < -12.0725) {
                offsetLat = 0.0012; // Zona La Fontana
            }

            map.panTo({ lat: r.Latitud + offsetLat, lng: r.Longitud });

            const walkingUrl = `https://www.google.com/maps/dir/?api=1&origin=-12.07203,-76.94205&destination=${r.Latitud},${r.Longitud}&travelmode=walking`;

            infoWindow.setContent(`
                <div style="max-width:220px; font-family:Inter,sans-serif; padding:4px;">
                    <img src="${r.FotoUrl}" onerror="this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=600'" style="width:100%; height:85px; object-fit:cover; border-radius:6px; margin-bottom:6px;" alt="${r.Nombre}" />
                    <b style="font-size:12px; display:block; line-height:1.2;">${r.Nombre}</b>
                    <div style="font-size:11px; color:#f59e0b; margin:2px 0;">★ ${r.CalificacionPromedio.toFixed(1)} (${r.TotalResenas} reseñas)</div>
                    <small style="color:#6b7280; display:block; margin-bottom:6px;">📍 ${r.DistanciaTexto}</small>
                    <div style="display:flex; gap:4px;">
                        <button onclick="abrirModalDetalle(${r.Id})" class="btn btn-sm btn-guinda" style="font-size:11px; padding:3px 8px; flex:1;">Ver Reseñas</button>
                        <a href="${walkingUrl}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" style="font-size:11px; padding:3px 8px;" title="Ruta a pie">
                            <i class="bi bi-person-walking"></i> Ruta
                        </a>
                    </div>
                </div>
            `);

            setTimeout(() => {
                infoWindow.open(map, marker);
            }, 100);
        }

        // Ajustar la cámara al panorama completo del cuadrante recortado
        function verCuadranteCompleto() {
            if (map) {
                map.fitBounds(boundsCuadranteFIA);
            }
        }

        // Centrar mapa de vuelta en la puerta principal de la FIA
        function centrarEnFia() {
            if (map) {
                map.setZoom(16.5);
                map.panTo(fiaCoords);
            }
        }

        // Obtener ubicación GPS real del alumno
        function miUbicacion() {
            if (!navigator.geolocation) {
                alert("La geolocalización no está soportada por tu navegador.");
                return;
            }

            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const userPos = {
                        lat: pos.coords.latitude,
                        lng: pos.coords.longitude
                    };

                    if (userMarker) {
                        userMarker.setPosition(userPos);
                    } else {
                        userMarker = new google.maps.Marker({
                            position: userPos,
                            map: map,
                            title: "Tu ubicación actual",
                            zIndex: 1000,
                            icon: {
                                path: google.maps.SymbolPath.CIRCLE,
                                scale: 8,
                                fillColor: "#0284c7",
                                fillOpacity: 1,
                                strokeColor: "#ffffff",
                                strokeWeight: 3
                            }
                        });
                    }

                    map.panTo(userPos);
                    map.setZoom(17);
                },
                (err) => {
                    alert("No se pudo obtener tu ubicación. Por favor permite los permisos de ubicación en el navegador.");
                },
                { enableHighAccuracy: true, timeout: 5000 }
            );
        }

        // Filtro por zona dentro del cuadrante recortado (sin radio circular)
        function filtrarPorZona(zona, btn) {
            document.querySelectorAll('.dist-filter-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            restos.forEach(r => {
                const marker = marcadores[r.Id];
                const card = document.getElementById(`card-rest-${r.Id}`);
                let visible = true;

                const texto = (r.Direccion + " " + r.DistanciaTexto + " " + r.Nombre).toLowerCase();

                if (zona === 'fontana') {
                    visible = texto.includes('fontana') || texto.includes('campus');
                } else if (zona === 'flora') {
                    visible = texto.includes('flora');
                }

                if (marker) marker.setVisible(visible);
                if (card) card.style.display = visible ? "" : "none";
            });

            if (zona === 'todos') {
                verCuadranteCompleto();
            }
        }

        // Enfocar un restaurante en el mapa al hacer clic en "Ver en mapa"
        function irARestauranteEnMapa(id) {
            const r = restos.find(x => x.Id === id);
            const marker = marcadores[id];
            if (map && r && marker) {
                document.getElementById('mapa-fia').scrollIntoView({ behavior: 'smooth', block: 'center' });
                abrirInfoWindowRestaurante(r, marker);
            }
        }

        // Cargar modal con reseñas reales y datos del local
        async function abrirModalDetalle(id) {
            try {
                const res = await fetch(`/Restaurantes/Detalle/${id}`);
                if (!res.ok) return;
                const d = await res.json();

                document.getElementById('modalRestauranteLabel').textContent = d.nombre;
                document.getElementById('modalDistancia').textContent = `${d.distanciaTexto} · ${d.direccion}`;
                document.getElementById('modalImg').src = d.fotoUrl;
                document.getElementById('modalCategoria').textContent = d.categoria;
                document.getElementById('modalRangoPrecios').textContent = d.rangoPrecios;
                document.getElementById('modalPromedio').textContent = d.calificacionPromedio.toFixed(1);
                document.getElementById('modalTotalResenas').textContent = `(${d.totalResenas} reseñas)`;
                document.getElementById('modalDesc').textContent = d.descripcion;
                document.getElementById('modalDireccion').textContent = d.direccion;
                document.getElementById('modalHorario').textContent = d.horarioAtencion;
                document.getElementById('formRestauranteId').value = d.id;

                // Enlaces de Google Maps
                document.getElementById('modalBtnRuta').href = `https://www.google.com/maps/dir/?api=1&origin=-12.07203,-76.94205&destination=${d.latitud},${d.longitud}&travelmode=walking`;
                document.getElementById('modalBtnGmaps').href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.nombre + ' ' + d.direccion)}`;

                // WhatsApp si existe
                if (d.telefonoWhatsApp) {
                    document.getElementById('modalBtnWaContainer').innerHTML = `
                        <a href="https://wa.me/51${d.telefonoWhatsApp}?text=Hola,%20soy%20estudiante%20de%20la%20USMP%20FIA,%20deseo%20hacer%20una%20consulta." target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-wa w-100">
                            <i class="bi bi-whatsapp me-1"></i>Contactar por WhatsApp
                        </a>
                    `;
                } else {
                    document.getElementById('modalBtnWaContainer').innerHTML = '';
                }

                // Reseñas de estudiantes
                const listaResenas = document.getElementById('modalResenasLista');
                if (d.resenas && d.resenas.length > 0) {
                    listaResenas.innerHTML = d.resenas.map(r => `
                        <div class="p-2 border rounded mb-2 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="avatar avatar-sm avatar-soft">${r.iniciales}</span>
                                    <span class="fw-semibold small">${r.autor}</span>
                                </div>
                                <span class="text-muted small">${r.fechaRelativa}</span>
                            </div>
                            <div class="stars-gold mb-1" style="font-size:12px;">
                                ${'★'.repeat(r.puntuacion)}${'☆'.repeat(5 - r.puntuacion)}
                            </div>
                            <p class="small mb-0 text-secondary">${r.comentario}</p>
                        </div>
                    `).join('');
                } else {
                    listaResenas.innerHTML = '<p class="text-muted small">Aún no hay reseñas. ¡Sé el primer estudiante en calificar este local!</p>';
                }

                const modal = new bootstrap.Modal(document.getElementById('modalRestaurante'));
                modal.show();
            } catch (err) {
                console.error("Error al cargar detalle:", err);
            }
        }
    </script>
}
